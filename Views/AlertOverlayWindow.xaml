<Window x:Class="TgSpecialWatch.Views.AlertOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="特别关注提醒"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#CC000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="#FF1A1A1A"
            BorderBrush="#FF3A3A3A"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28"
            MinWidth="440"
            MaxWidth="640">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Border DockPanel.Dock="Left"
                        Width="40" Height="40"
                        CornerRadius="20"
                        Background="#FF2A2A2A"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top">
                    <Path Data="{StaticResource IconBell}"
                          Fill="White"
                          Width="18" Height="18"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="特别关注提醒"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock x:Name="RuleText"
                               Foreground="#FF9A9A9A"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <Border Background="#FF141414"
                    BorderBrush="#FF2E2E2E"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="SourceText"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText"
                               FontSize="15"
                               Foreground="#FFE0E0E0"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"/>
                    <TextBlock x:Name="TimeText"
                               Foreground="#FF8A8A8A"
                               Margin="0,10,0,0"/>
                    <TextBlock x:Name="PendingText"
                               Foreground="#FFBDBDBD"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource AppPrimaryButton}"
                    hc:IconElement.Geometry="{StaticResource IconCheck}"
                    Content="我已收到"
                    Height="42"
                    FontSize="15"
                    Click="AckButton_Click"/>
        </StackPanel>
    </Border>
</Window>
