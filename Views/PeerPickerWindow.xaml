<Window x:Class="TgSpecialWatch.Views.PeerPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="从会话列表选择"
        Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Style="{StaticResource AppWindowRootStyle}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource AppDefaultButton}"
                        hc:IconElement.Geometry="{StaticResource IconCancel}"
                        Content="取消"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Style="{StaticResource AppPrimaryButton}"
                        hc:IconElement.Geometry="{StaticResource IconCheck}"
                        Content="选用"
                        IsDefault="True"
                        Click="ConfirmButton_Click"/>
            </StackPanel>

            <Border Style="{StaticResource AppCardStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <DockPanel Margin="0,0,0,10">
                            <Path DockPanel.Dock="Left"
                                  Data="{StaticResource IconList}"
                                  Fill="{DynamicResource AppTitleBrush}"
                                  Width="16" Height="16"
                                  Stretch="Uniform"
                                  Margin="0,2,8,0"
                                  VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="选择会话" Style="{StaticResource AppSectionTitleStyle}"/>
                                <TextBlock x:Name="HintText"
                                           Text="双击或选中后点「选用」。"
                                           Style="{StaticResource AppMutedTextStyle}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <hc:TextBox x:Name="SearchBox"
                                    hc:InfoElement.Title="搜索"
                                    hc:InfoElement.Placeholder="名称 / @用户名 / ID"
                                    TextChanged="SearchBox_TextChanged"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               DockPanel.Dock="Bottom"
                               Style="{StaticResource AppMutedTextStyle}"
                               Margin="0,10,0,0"
                               Text="加载中…"/>

                    <ListBox x:Name="PeerList"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="PeerList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,0,0,4"
                                        Background="#FF141414"
                                        BorderBrush="#FF2E2E2E"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFF5F5F5"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="#FF9A9A9A"
                                                       FontSize="12"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Background="#FF2A2A2A"
                                                CornerRadius="6"
                                                Padding="8,2"
                                                Margin="12,0,0,0">
                                            <TextBlock Text="{Binding KindLabel}"
                                                       Foreground="#FFCFCFCF"
                                                       FontSize="11"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
