<Window x:Class="TgSpecialWatch.Views.RuleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="编辑特别关注规则"
        Height="600" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Style="{StaticResource AppWindowRootStyle}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource AppDefaultButton}"
                        hc:IconElement.Geometry="{StaticResource IconCancel}"
                        Content="取消"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Style="{StaticResource AppPrimaryButton}"
                        hc:IconElement.Geometry="{StaticResource IconSave}"
                        Content="保存"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>

            <Border Style="{StaticResource AppCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="规则配置" Style="{StaticResource AppSectionTitleStyle}" Margin="0,0,0,14"/>

                        <hc:TextBox x:Name="NameBox"
                                    hc:InfoElement.Title="名称"
                                    hc:InfoElement.Necessary="True"
                                    Margin="0,0,0,12"/>

                        <TextBlock Text="类型" Style="{StaticResource AppMutedTextStyle}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ScopeBox"
                                  Margin="0,0,0,12"
                                  SelectionChanged="ScopeBox_SelectionChanged">
                            <ComboBoxItem Content="整个联系人" Tag="User"/>
                            <ComboBoxItem Content="整个群" Tag="Chat"/>
                            <ComboBoxItem Content="关键词" Tag="Keyword"/>
                        </ComboBox>

                        <TextBlock Text="目标会话 · Peer Id" Style="{StaticResource AppMutedTextStyle}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <hc:TextBox x:Name="PeerIdBox"
                                        Grid.Column="0"
                                        Height="36"
                                        VerticalAlignment="Center"
                                        hc:InfoElement.Placeholder="从右侧选择会话后自动填写"
                                        IsReadOnly="True"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource AppDefaultButton}"
                                    hc:IconElement.Geometry="{StaticResource IconList}"
                                    Content="从会话选择"
                                    Height="36"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="PickPeerButton_Click"/>
                        </Grid>

                        <TextBlock Text="显示名" Style="{StaticResource AppMutedTextStyle}" Margin="0,0,0,6"/>
                        <hc:TextBox x:Name="PeerNameBox"
                                    Height="36"
                                    hc:InfoElement.Placeholder="从会话选择后自动填写"
                                    IsReadOnly="True"
                                    Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Style="{StaticResource AppDefaultButton}"
                                    Content="清除会话"
                                    Height="32"
                                    Padding="12,0"
                                    Click="ClearPeerButton_Click"/>
                            <TextBlock x:Name="PeerHintText"
                                       Style="{StaticResource AppMutedTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <hc:TextBox x:Name="KeywordBox"
                                    hc:InfoElement.Title="关键词"
                                    Margin="0,0,0,8"/>

                        <CheckBox x:Name="IgnoreCaseBox"
                                  Content="关键词忽略大小写"
                                  IsChecked="True"
                                  Margin="0,0,0,12"/>

                        <TextBlock Text="提醒强度" Style="{StaticResource AppMutedTextStyle}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="LevelBox" Margin="0,0,0,12">
                            <ComboBoxItem Content="置顶弹窗 + 声音" Tag="Strong"/>
                            <ComboBoxItem Content="全屏打断 + 声音" Tag="FullScreen"/>
                        </ComboBox>

                        <CheckBox x:Name="EnabledBox"
                                  Content="启用该规则"
                                  IsChecked="True"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</Window>
