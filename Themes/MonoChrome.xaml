    <!-- 自绘模板：图标/文字都跟随 Foreground，避免 HC 白字叠浅底 -->
    <ControlTemplate x:Key="AppButtonTemplate" TargetType="Button">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path x:Name="IconPath"
                      Data="{Binding Path=(hc:IconElement.Geometry), RelativeSource={RelativeSource TemplatedParent}}"
                      Fill="{TemplateBinding Foreground}"
                      Width="14" Height="14"
                      Stretch="Uniform"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(hc:IconElement.Geometry), RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Margin" Value="0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- 浅底深字：主操作 -->
    <Style x:Key="AppPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="#FFF2F2F2"/>
        <Setter Property="BorderBrush" Value="#FFF2F2F2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AppPrimaryButtonFg}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource AppButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FFE8E8E8"/>
                <Setter Property="BorderBrush" Value="#FFE8E8E8"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FFD6D6D6"/>
                <Setter Property="BorderBrush" Value="#FFD6D6D6"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#FF3A3A3A"/>
                <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
                <Setter Property="Foreground" Value="#FF9A9A9A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 深底浅字：次要操作 -->
    <Style x:Key="AppDefaultButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppDefaultButtonBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppDefaultButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource AppDefaultButtonFg}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource AppButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF383838"/>
                <Setter Property="BorderBrush" Value="#FF777777"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#FF222222"/>
                <Setter Property="BorderBrush" Value="#FF999999"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="#FF1F1F1F"/>
                <Setter Property="BorderBrush" Value="#FF333333"/>
                <Setter Property="Foreground" Value="#FF6A6A6A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource AppCardCornerRadius}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="AppWindowRootStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="AppSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppTitleBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="AppMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 下拉：选中/悬停用深灰底 + 浅色字，避免浅底白字看不清 -->
    <SolidColorBrush x:Key="AppComboSelectedBg" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="AppComboHoverBg" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="AppComboItemFg" Color="#FFF5F5F5"/>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource AppComboItemFg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppComboHoverBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource AppComboItemFg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppComboSelectedBg}"/>
                            <Setter Property="Foreground" Value="{StaticResource AppComboItemFg}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsHighlighted" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="#FF4A4A4A"/>
                            <Setter Property="Foreground" Value="{StaticResource AppComboItemFg}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF777777"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Foreground" Value="{StaticResource AppComboItemFg}"/>
    </Style>
</ResourceDictionary>
