<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!-- 黑白简约色板（不再把 Primary 设成纯白，避免 HC 白字叠白底） -->
    <Color x:Key="PrimaryColor">#FFF2F2F2</Color>
    <Color x:Key="DarkPrimaryColor">#FFE0E0E0</Color>
    <Color x:Key="LightPrimaryColor">#FFBDBDBD</Color>
    <Color x:Key="AccentColor">#FFF2F2F2</Color>
    <Color x:Key="DarkAccentColor">#FFE0E0E0</Color>
    <Color x:Key="DangerColor">#FFCFCFCF</Color>
    <Color x:Key="DarkDangerColor">#FFB0B0B0</Color>
    <Color x:Key="WarningColor">#FFD0D0D0</Color>
    <Color x:Key="InfoColor">#FFC8C8C8</Color>
    <Color x:Key="SuccessColor">#FFEAEAEA</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource DarkPrimaryColor}"/>
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource LightPrimaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="DarkAccentBrush" Color="{StaticResource DarkAccentColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DarkDangerBrush" Color="{StaticResource DarkDangerColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0F0F0F"/>
    <SolidColorBrush x:Key="AppCardBrush" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FF2E2E2E"/>
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="AppTitleBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="AppPrimaryButtonFg" Color="#FF111111"/>
    <SolidColorBrush x:Key="AppDefaultButtonBg" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="AppDefaultButtonFg" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="AppDefaultButtonBorder" Color="#FF555555"/>

    <CornerRadius x:Key="AppCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="AppButtonCornerRadius">8</CornerRadius>

