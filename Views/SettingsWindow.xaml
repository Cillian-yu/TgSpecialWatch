<Window x:Class="TgSpecialWatch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="设置"
        Height="560" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Style="{StaticResource AppWindowRootStyle}">
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource AppDefaultButton}"
                        hc:IconElement.Geometry="{StaticResource IconCancel}"
                        Content="取消"
                        Margin="0,0,8,0"
                        IsCancel="True"/>
                <Button Style="{StaticResource AppPrimaryButton}"
                        hc:IconElement.Geometry="{StaticResource IconSave}"
                        Content="保存"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource AppCardStyle}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="提示音" Style="{StaticResource AppSectionTitleStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="支持 wav / mp3 等本地文件；留空则使用系统提示音。"
                                       Style="{StaticResource AppMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <hc:TextBox x:Name="SoundPathBox"
                                            Grid.Column="0"
                                            Height="36"
                                            hc:InfoElement.Placeholder="音频文件路径"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource AppDefaultButton}"
                                        Content="浏览…"
                                        Height="36"
                                        Margin="8,0,0,0"
                                        Click="BrowseSound_Click"/>
                            </Grid>
                            <Button Style="{StaticResource AppDefaultButton}"
                                    hc:IconElement.Geometry="{StaticResource IconBell}"
                                    Content="试听一次"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Click="TestSound_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppCardStyle}">
                        <StackPanel>
                            <TextBlock Text="局域网 Socket 广播" Style="{StaticResource AppSectionTitleStyle}" Margin="0,0,0,12"/>
                            <TextBlock Text="启用后，本机作为服务端；安卓填写本机局域网 IP 与端口即可接收特别关注提醒。任一端点「我已收到」会联动停止。"
                                       Style="{StaticResource AppMutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <CheckBox x:Name="SocketEnabledBox"
                                      Content="启用 Socket 服务端"
                                      Margin="0,0,0,12"/>

                            <hc:TextBox x:Name="SocketPortBox"
                                        hc:InfoElement.Title="端口"
                                        hc:InfoElement.Necessary="True"
                                        Text="18999"
                                        Margin="0,0,0,12"/>

                            <Border Background="#FF141414"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock x:Name="SocketStatusText"
                                               Style="{StaticResource AppMutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="Socket 状态：未知"/>
                                    <TextBlock x:Name="LocalIpText"
                                               Foreground="#FFF5F5F5"
                                               FontSize="13"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
