<Window x:Class="TgSpecialWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="TgSpecialWatch · 特别关注"
        Height="620" Width="960"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border Style="{StaticResource AppWindowRootStyle}">
        <DockPanel>
            <!-- 顶栏 -->
            <Border DockPanel.Dock="Top" Style="{StaticResource AppCardStyle}" Margin="0,0,0,14" Padding="18,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TgSpecialWatch" Style="{StaticResource AppSectionTitleStyle}" FontSize="20"/>
                        <TextBlock x:Name="StatusText"
                                   Text="未连接"
                                   Style="{StaticResource AppMutedTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AppPrimaryButton}"
                                hc:IconElement.Geometry="{StaticResource IconLogin}"
                                Content="登录 / 连接"
                                Margin="0,0,8,0"
                                Click="LoginButton_Click"/>
                        <Button Style="{StaticResource AppDefaultButton}"
                                hc:IconElement.Geometry="{StaticResource IconLogout}"
                                Content="断开"
                                Margin="0,0,8,0"
                                Click="DisconnectButton_Click"/>
                        <Button Style="{StaticResource AppDefaultButton}"
                                hc:IconElement.Geometry="{StaticResource IconBell}"
                                Content="测试提醒"
                                Margin="0,0,8,0"
                                Click="TestAlertButton_Click"/>
                        <Button Style="{StaticResource AppDefaultButton}"
                                hc:IconElement.Geometry="{StaticResource IconSettings}"
                                Content="设置"
                                Click="SettingsButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底栏 -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource AppCardStyle}" Margin="0,14,0,0" Padding="16,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               Text="数据目录：%AppData%\TgSpecialWatch"
                               Style="{StaticResource AppMutedTextStyle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource AppPrimaryButton}"
                                hc:IconElement.Geometry="{StaticResource IconAdd}"
                                Content="新增规则"
                                Margin="0,0,8,0"
                                Click="AddRule_Click"/>
                        <Button Style="{StaticResource AppDefaultButton}"
                                hc:IconElement.Geometry="{StaticResource IconEdit}"
                                Content="编辑"
                                Margin="0,0,8,0"
                                Click="EditRule_Click"/>
                        <Button Style="{StaticResource AppDefaultButton}"
                                hc:IconElement.Geometry="{StaticResource IconDelete}"
                                Content="删除"
                                Click="DeleteRule_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 规则卡片 -->
            <Border Style="{StaticResource AppCardStyle}" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="特别关注规则" Style="{StaticResource AppSectionTitleStyle}" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="人 / 群 / 关键词"
                                   Style="{StaticResource AppMutedTextStyle}"/>
                    </DockPanel>

                    <DataGrid x:Name="RulesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              BorderThickness="0"
                              Background="Transparent"
                              GridLinesVisibility="Horizontal"
                              AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="56"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Scope}" Width="90"/>
                            <DataGridTextColumn Header="Peer" Binding="{Binding PeerDisplay}" Width="180"/>
                            <DataGridTextColumn Header="关键词" Binding="{Binding Keyword}" Width="*"/>
                            <DataGridTextColumn Header="强度" Binding="{Binding Level}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DockPanel>
    </Border>
</Window>
